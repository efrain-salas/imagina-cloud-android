    <string name="imagina_oauth_client_id" translatable="false"></string>
    <string name="imagina_sign_in">Sign in with Imagina</string>
    <string name="imagina_sign_in_cancelled">To use Imagina Cloud, sign in with your mobile number.</string>
    <string name="imagina_sign_in_failed">Could not sign in with Imagina. Try again.</string>
    <string name="imagina_sign_in_leave">Leave</string>
</resources>
