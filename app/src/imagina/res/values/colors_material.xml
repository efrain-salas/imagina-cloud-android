<?xml version="1.0" encoding="utf-8"?>
<!--
  Imagina's tokens for Material 3's baseline colours. Nextcloud's themes inherit Theme.Material3.Light / .Dark, and
  whatever the app does not colour itself (dialogs, menus, sheets, cards, fields, switches, chips…) takes these
  m3_sys_color_* values, which are the library's purple baseline unless the app overrides them: an app resource
  named like the library's wins over it. Literal hex on purpose (the light set is always the light tokens and the
  dark set the dark ones, whatever the theme is). Lint is told to accept the override of the library's private resources
  and to ignore that nothing in the app refers to them (the library does). See IMAGINA.md, «Colores».

  Mapping: page and bars = canvas; dialogs, menus, sheets, cards = surface (white / #1A1B25); fields, tracks and
  the like = surface-muted; selected = accent-soft with accent-soft-text; outlines = border-control; errors = danger.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PrivateResource,UnusedResources">
    <!-- Light -->
    <color name="m3_sys_color_light_primary">#0F766E</color>
    <color name="m3_sys_color_light_on_primary">#FFFFFF</color>
    <color name="m3_sys_color_light_primary_container">#CCFBF1</color>
    <color name="m3_sys_color_light_on_primary_container">#134E4A</color>
    <color name="m3_sys_color_light_inverse_primary">#2DD4BF</color>
    <color name="m3_sys_color_light_secondary">#474B57</color>
    <color name="m3_sys_color_light_on_secondary">#FFFFFF</color>
