<?xml version="1.0" encoding="utf-8"?>
<!--
  Instrument Sans, the typeface of Imagina's interfaces (SIL Open Font License 1.1, LICENSES/OFL-1.1.txt):
  static instances for the four weights the design system uses. The app's themes use this family
  (app/src/imagina/res/values/themes_imagina.xml); Fraunces is only for the empty-state headline.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/instrument_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/instrument_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/instrument_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/instrument_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
